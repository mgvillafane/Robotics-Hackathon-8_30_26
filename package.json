{
  "name": "hackathon-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web-based robot arm simulator driven by streamed joint states. Supports multiple arms, starting with the LeRobot SO-101.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "bridge": "node server/bridge.mjs",
    "demo": "node server/demo-publisher.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "inspect:pose": "node scripts/inspect-pose.mjs",
    "inspect:hand": "node scripts/inspect-hand.mjs",
    "verify:retarget": "node scripts/verify-retarget.mjs",
    "verify:hand": "node scripts/verify-hand.mjs",
    "verify:ik": "node scripts/verify-ik.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14",
    "urdf-loader": "^0.13.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.2.2",
    "ws": "^8.18.0"
  }
}
